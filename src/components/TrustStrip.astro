---
import Icon from './Icon.astro';

const items = [
  { icon: 'badge-check', text: 'Qualified, verified staff' },
  { icon: 'phone-call', text: '24/7 phone & WhatsApp' },
  { icon: 'moon', text: 'Day, night & 24-hour care' },
  { icon: 'users', text: 'Female & male staff available' },
  { icon: 'map-pin', text: 'Homes across Lahore' },
];
---

<div class="border-y border-line bg-white">
  <ul class="container-x grid grid-cols-2 gap-x-4 gap-y-4 py-6 sm:grid-cols-3 lg:grid-cols-5">
    {items.map((it, i) => (
      <li class:list={['flex items-center gap-3 text-[0.98rem] font-semibold text-ink', i === 4 && 'hidden sm:flex']} data-reveal style={`--i:${i}`}>
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary-soft text-primary"><Icon name={it.icon} size={20} /></span>
        {it.text}
      </li>
    ))}
  </ul>
</div>
