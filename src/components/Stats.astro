---
import { stats } from '../data/content';
---

<dl class="grid grid-cols-2 gap-6 lg:grid-cols-4">
  {stats.map((s, i) => (
    <div class="rounded-[var(--radius-card)] border border-line bg-white p-6 text-center" data-reveal style={`--i:${i}`}>
      <dt class="sr-only">{s.label}</dt>
      <dd class="font-display text-5xl font-medium text-primary tabular-nums lg:text-6xl">
        <span aria-hidden="true" data-count={s.value}>{s.value}</span><span class="sr-only">{s.value}</span>{s.suffix}
      </dd>
      <dd class="mt-2 font-semibold text-ink" aria-hidden="true">{s.label}</dd>
    </div>
  ))}
</dl>
