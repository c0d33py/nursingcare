---
// Native <details> accordions (M09). Each item is deep-linkable: /faq/#<id>.
import { href } from '../site';
import Icon from './Icon.astro';

interface Item { id: string; question: string; answer: string; link?: { label: string; href: string } }
interface Props { items: Item[]; class?: string }
const { items, class: className = '' } = Astro.props;
---

<div class:list={['faq-list divide-y divide-line rounded-[var(--radius-card)] border border-line bg-white', className]}>
  {items.map((f) => (
    <details id={f.id} class="faq-item group" data-faq>
      <summary class="flex cursor-pointer items-start justify-between gap-4 px-5 py-5 text-left text-[1.1rem] font-semibold text-ink sm:px-7">
        <span>{f.question}</span>
        <span class="faq-chevron mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-sky text-primary"><Icon name="chevron-down" size={18} /></span>
      </summary>
      <div class="px-5 pb-6 text-muted sm:px-7">
        <p class="max-w-[68ch]">{f.answer}</p>
        {f.link && <a href={href(f.link.href)} class="link mt-3 inline-block">{f.link.label} →</a>}
      </div>
    </details>
  ))}
</div>

<style>
  .faq-item summary { list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--color-primary); }
  .faq-chevron { transition: transform 240ms var(--ease-in-out); }
  .faq-item[open] .faq-chevron { transform: rotate(180deg); }
  .faq-item::details-content { block-size: 0; overflow-y: clip; transition: block-size 240ms var(--ease-in-out), content-visibility 240ms allow-discrete; }
  .faq-item[open]::details-content { block-size: auto; }
  .faq-item:target summary, .faq-item:focus-within summary { color: var(--color-primary); }
</style>
