---
import { iconSvg } from '../lib/icons';

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  label?: string;
}
const { name, size = 24, class: className = '', label = '' } = Astro.props;
---

<Fragment set:html={iconSvg(name, { size: Number(size), className, label })} />
