---
// M31 — vitals panel + ECG trace (two beats, then rests; replays on hover). Example values only.
import Icon from './Icon.astro';

const vitals = [
  { icon: 'heart-pulse', label: 'Blood pressure', value: '120/80', unit: 'mmHg' },
  { icon: 'droplet', label: 'Blood sugar', count: 110, unit: 'mg/dL' },
  { icon: 'activity', label: 'SpO₂', count: 98, unit: '%' },
  { icon: 'heart', label: 'Pulse', count: 76, unit: 'bpm' },
  { icon: 'thermometer', label: 'Temperature', value: '98.4', unit: '°F' },
  { icon: 'wind', label: 'Breathing', count: 16, unit: '/min' },
];
---

<figure class="vitals glass p-5 sm:p-6">
  <div class="flex items-center justify-between">
    <p class="font-semibold text-ink">Today’s readings</p>
    <span class="flex items-center gap-1.5 rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold text-primary-strong"><span class="size-2 rounded-full bg-success"></span>All in range</span>
  </div>
  <svg class="ecg mt-4 h-16 w-full" viewBox="0 0 600 80" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M0 44 H90 L104 44 L114 18 L126 70 L138 6 L150 58 L160 44 H300 L314 44 L324 18 L336 70 L348 6 L360 58 L370 44 H600" fill="none" stroke="var(--color-primary)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"></path>
  </svg>
  <dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
    {vitals.map((v) => (
      <div class="rounded-2xl bg-white p-3.5">
        <dt class="flex items-center gap-1.5 text-[0.85rem] font-medium text-muted"><Icon name={v.icon} size={16} class="text-primary" />{v.label}</dt>
        <dd class="mt-1 font-display text-2xl font-medium text-ink tabular-nums">
          {v.count !== undefined ? <><span aria-hidden="true" data-count={v.count}>{v.count}</span><span class="sr-only">{v.count}</span></> : v.value}
          <span class="ml-0.5 font-sans text-sm font-medium text-muted">{v.unit}</span>
        </dd>
      </div>
    ))}
  </dl>
  <figcaption class="mt-3 text-xs text-muted">Example readings for illustration</figcaption>
</figure>

<style>
  .ecg path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(html.js:not([data-motion="C"])) .ecg path { animation: ecg-draw 3s linear 1 both; }
  :global(html.js:not([data-motion="C"])) .vitals:hover .ecg path { animation: ecg-redraw 3s linear 1 both; }
  @keyframes ecg-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes ecg-redraw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
</style>
