---
// Four steps joined by a path that draws on scroll (M27) with line-art icons (M41).
import { steps } from '../data/content';
import Icon from './Icon.astro';
---

<div class="hiw relative">
  <svg class="hiw-path pointer-events-none absolute inset-x-0 top-[52px] hidden h-16 w-full lg:block" viewBox="0 0 1000 64" preserveAspectRatio="none" aria-hidden="true" data-reveal>
    <path d="M125 32 C 250 -8, 375 72, 500 32 S 750 -8, 875 32" pathLength="1" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-dasharray="1 1" stroke-linecap="round"></path>
  </svg>
  <ol class="relative grid gap-10 lg:grid-cols-4 lg:gap-8">
    {steps.map((s, i) => (
      <li class="hiw-step relative flex gap-5 lg:flex-col lg:items-center lg:text-center" data-reveal style={`--i:${i}`}>
        <div class="relative z-10 grid size-[104px] shrink-0 place-items-center rounded-full border border-line bg-white shadow-[var(--shadow-soft)]">
          <span class="draw text-primary"><Icon name={s.icon} size={44} /></span>
          <span class="absolute -top-1 -right-1 grid size-9 place-items-center rounded-full bg-accent font-display text-lg font-semibold text-ink">{i + 1}</span>
        </div>
        <div class="pt-2 lg:pt-0">
          <h3 class="h3">{s.title}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .hiw-path path { stroke-dashoffset: 0; transition: stroke-dashoffset 1600ms var(--ease-in-out) 200ms; }
  :global(html.js) .hiw-path:not(.is-in) path { stroke-dashoffset: 1; }
  .hiw-path[data-reveal] { opacity: 1 !important; translate: none !important; }

  /* Mobile: a vertical connector between steps */
  @media (max-width: 1023px) {
    .hiw-step:not(:last-child)::before {
      content: ""; position: absolute; left: 51px; top: 110px; bottom: -36px; width: 2px;
      background: linear-gradient(var(--color-accent), rgb(231 169 60 / 0.2));
      transform-origin: top; transition: transform 700ms var(--ease-out) 300ms;
    }
    :global(html.js) .hiw-step:not(.is-in)::before { transform: scaleY(0); }
  }
</style>
