---
// M28 — pinned day→night story on capable desktops (motion-a.ts adds .dn--live);
// four stacked, self-coloured cards everywhere else. All copy is real HTML.
import { href } from '../site';
import { dayStages } from '../data/content';
import Icon from './Icon.astro';
---

<section class="dn" data-daynight aria-labelledby="dn-title">
  <div class="dn-pin">
    <div class="dn-bgs dn-live-only" aria-hidden="true">
      {dayStages.map((_, i) => <div class={`dn-bg dn-bg-${i}`}></div>)}
      <canvas class="dn-particles" data-particles></canvas>
    </div>

    <div class="container-x dn-inner">
      <div class="dn-copy">
        <p class="eyebrow mb-4" data-reveal>Day & night support</p>
        <h2 id="dn-title" class="h2 dn-title" data-reveal style="--i:1">Care that doesn't clock off</h2>
        <p class="dn-intro mt-4 max-w-xl text-lg" data-reveal style="--i:2">
          Day shifts, night shifts or round-the-clock care. We arrange staff around the hours your loved one needs.
        </p>

        <ol class="dn-cards mt-10">
          {dayStages.map((s, i) => (
            <li class:list={['dn-card', `dn-card-${i}`, i === 0 && 'is-active']} data-time={s.time} data-reveal style={`--i:${i}`}>
              <span class="dn-card-icon"><Icon name={s.icon} size={26} /></span>
              <p class="dn-time">{s.time} · {s.label}</p>
              <p class="dn-text">{s.text}</p>
            </li>
          ))}
        </ol>

        <div class="dn-live-only mt-8 flex items-center gap-2" role="group" aria-label="Jump to time of day">
          {dayStages.map((s, i) => (
            <button type="button" class="dn-dot" aria-current={i === 0 ? 'true' : 'false'}>
              <span class="sr-only">{s.label}</span>
            </button>
          ))}
        </div>

        <p class="dn-note mt-8 text-[0.95rem]">
          Examples only. Every care plan is tailored.
          <a href={href('/care-plans')} class="ml-1 font-semibold underline underline-offset-4">Explore care plans →</a>
        </p>
      </div>

      <div class="dn-sky dn-live-only" aria-hidden="true">
        <p class="dn-clock font-display" data-clock>8:00 am</p>
        <svg viewBox="0 0 600 300" class="w-full">
          <path d="M50 240 A 250 190 0 0 1 550 240" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 8"></path>
          <g data-sun>
            <circle r="34" fill="#f6b84a" opacity="0.25"></circle>
            <circle r="22" fill="#f6b84a"></circle>
          </g>
          <g data-moon style="opacity:0">
            <circle r="20" fill="#f4ecd8"></circle>
            <circle cx="9" cy="-6" r="17" fill="#13294a"></circle>
          </g>
          <!-- home on the horizon: its window lights up at night -->
          <g transform="translate(300 240)">
            <path d="M-70 0 V-52 L0 -100 L70 -52 V0 Z" fill="currentColor" fill-opacity="0.14"></path>
            <path d="M-14 0 V-30 a14 14 0 0 1 28 0 V0 Z" class="dn-door"></path>
            <rect x="-48" y="-48" width="20" height="18" rx="3" class="dn-window"></rect>
            <rect x="28" y="-48" width="20" height="18" rx="3" class="dn-window"></rect>
          </g>
          <line x1="0" y1="240" x2="600" y2="240" stroke="currentColor" stroke-opacity="0.2" stroke-width="2"></line>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .dn { --dn-ink: var(--color-ink); position: relative; background: var(--color-cream); }
  .dn-inner { padding-block: 6rem; }
  .dn-live-only { display: none; }
  .dn-title { color: var(--dn-ink); }
  .dn-intro, .dn-note { color: var(--color-muted); }

  /* Static / mobile / reduced motion: four stacked, self-coloured cards */
  .dn-cards { display: grid; gap: 1rem; }
  @media (min-width: 768px) { .dn-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .dn:not(.dn--live) .dn-cards { grid-template-columns: repeat(4, 1fr); } }
  .dn-card { border-radius: var(--radius-card); padding: 1.5rem; color: var(--color-ink); }
  .dn-card-0 { background: linear-gradient(160deg, #fff6e6, #fbe1bd); }
  .dn-card-1 { background: linear-gradient(160deg, #e9f6fa, #c4e5ee); }
  .dn-card-2 { background: linear-gradient(160deg, #f5c79c, #b9677a); color: white; }
  .dn-card-3 { background: linear-gradient(160deg, #1b3460, #0b1b2b); color: white; }
  .dn-card-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 999px; background: rgb(255 255 255 / 0.55); color: var(--color-ink); }
  .dn-card-2 .dn-card-icon, .dn-card-3 .dn-card-icon { background: rgb(255 255 255 / 0.15); color: #ffd98f; }
  .dn-time { margin-top: 1rem; font-weight: 700; letter-spacing: 0.02em; }
  .dn-text { margin-top: 0.35rem; font-size: 1.05rem; opacity: 0.9; }

  /* Live (Tier A, pinned) */
  .dn--live .dn-live-only { display: block; }
  .dn--live .dn-live-only[role="group"] { display: flex; }
  .dn--live .dn-pin { position: relative; height: 100vh; overflow: hidden; }
  .dn--live .dn-inner {
    position: relative; height: 100%; padding-block: calc(var(--header-h) + 2rem) 3rem;
    display: grid; grid-template-columns: 1fr 1.1fr; align-items: center; gap: 3rem;
  }
  .dn-bgs, .dn-bg, .dn-particles { position: absolute; inset: 0; }
  .dn-particles { width: 100%; height: 100%; }
  .dn-bg { opacity: 0; }
  .dn-bg-0 { background: linear-gradient(180deg, #fff8ec, #fbe4c4); opacity: 1; }
  .dn-bg-1 { background: linear-gradient(180deg, #e8f6fb, #bfe1ea); }
  .dn-bg-2 { background: linear-gradient(180deg, #f6c99a, #c96f7a 60%, #5b3f6b); }
  .dn-bg-3 { background: radial-gradient(120% 90% at 70% 10%, #1d3a66, #0b1b2b 70%); }
  .dn--live .dn-cards { position: relative; min-height: 190px; display: block; }
  .dn--live .dn-card {
    position: absolute; inset: 0 auto auto 0; width: min(100%, 460px);
    background: rgb(255 255 255 / 0.55); color: var(--dn-ink);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    opacity: 0 !important; translate: 0 16px !important;
    transition: opacity 400ms var(--ease-in-out), translate 400ms var(--ease-out), color 400ms;
  }
  .dn--live .dn-card.is-active { opacity: 1 !important; translate: 0 0 !important; }
  .dn--live[data-stage="2"], .dn--live[data-stage="3"] { --dn-ink: #fff; }
  .dn--live[data-stage="2"] .dn-card, .dn--live[data-stage="3"] .dn-card { background: rgb(255 255 255 / 0.12); }
  .dn--live[data-stage="2"] :is(.dn-intro, .dn-note), .dn--live[data-stage="3"] :is(.dn-intro, .dn-note) { color: rgb(255 255 255 / 0.8); }
  .dn--live[data-stage="2"] .eyebrow, .dn--live[data-stage="3"] .eyebrow { color: var(--color-accent); }
  .dn-title, .dn-intro, .dn-note, .dn-sky { transition: color 400ms; }
  .dn-sky { color: var(--dn-ink); position: relative; }
  .dn-clock { font-size: clamp(2.5rem, 4vw, 4rem); font-weight: 500; text-align: center; margin-bottom: 1rem; }
  .dn-door { fill: currentColor; fill-opacity: 0.25; }
  .dn-window { fill: currentColor; fill-opacity: 0.2; transition: fill 600ms, fill-opacity 600ms; }
  .dn--live[data-stage="3"] .dn-window, .dn--live[data-stage="3"] .dn-door { fill: #ffd27a; fill-opacity: 1; filter: drop-shadow(0 0 10px #ffd27a); }
  .dn-dot { width: 44px; height: 44px; border-radius: 999px; display: grid; place-items: center; }
  .dn-dot::before { content: ""; width: 12px; height: 12px; border-radius: 999px; background: currentColor; opacity: 0.3; transition: opacity 200ms, transform 200ms; color: var(--dn-ink); }
  .dn-dot[aria-current="true"]::before { opacity: 1; transform: scale(1.3); background: var(--color-accent); }
</style>
