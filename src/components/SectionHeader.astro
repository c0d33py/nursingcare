---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  center?: boolean;
  id?: string;
  class?: string;
  invert?: boolean;
}
const { eyebrow, title, text, center = false, id, class: className = '', invert = false } = Astro.props;
---

<div class:list={['max-w-3xl', center && 'mx-auto text-center', className]}>
  {eyebrow && <p class:list={['eyebrow mb-4', center && 'justify-center', invert && '!text-accent']} data-reveal>{eyebrow}</p>}
  <h2 id={id} class:list={['h2', invert && '!text-white']} data-reveal style="--i:1">{title}</h2>
  {text && <p class:list={['mt-4 text-lg', invert ? 'text-white/75' : 'text-muted']} data-reveal style="--i:2">{text}</p>}
  <slot />
</div>
