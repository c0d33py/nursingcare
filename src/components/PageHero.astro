---
// Standard hero for T2/T3/T5/T6 pages: breadcrumb, H1, subhead, actions, optional arch image.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  crumbs?: { label: string; href?: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  tone?: 'sky' | 'cream';
}
const { eyebrow, title, subtitle, crumbs, image, imageAlt = '', imagePosition = 'center', tone = 'sky' } = Astro.props;
---

<section class:list={['relative overflow-hidden', tone === 'sky' ? 'bg-sky' : 'bg-cream']}>
  <div class="hero-blob" aria-hidden="true"></div>
  <div class:list={['container-x relative grid items-center gap-10 py-12 lg:py-20', image && 'lg:grid-cols-[1.15fr_0.85fr]']}>
    <div>
      {crumbs && <div class="mb-6"><Breadcrumbs items={crumbs} /></div>}
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h1 class="h1 max-w-3xl">{title}</h1>
      {subtitle && <p class="lead mt-5 max-w-2xl">{subtitle}</p>}
      <slot />
    </div>
    {image && (
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="arch-soft aspect-[4/5] bg-primary-soft shadow-[var(--shadow-lift)]" data-parallax-frame>
          <Image src={image} alt={imageAlt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 90vw" class="h-full w-full object-cover" style={`object-position:${imagePosition}`} loading="eager" fetchpriority="high" />
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero-blob {
    position: absolute; right: -10%; top: -30%; width: 60vw; height: 60vw; max-width: 760px; max-height: 760px;
    background: radial-gradient(closest-side, rgb(231 169 60 / 0.18), transparent);
    pointer-events: none;
  }
</style>
