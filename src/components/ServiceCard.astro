---
// Interactive service card (M25): lift, icon rise, pointer tilt on desktop, stretched link.
import type { CollectionEntry } from 'astro:content';
import { href, lcFirst } from '../site';
import Icon from './Icon.astro';
import IconTile from './IconTile.astro';

interface Props {
  service: CollectionEntry<'services'>;
  index?: number;
  showIncluded?: boolean;
  morph?: boolean; // shared-element view transition to the service hero (M11)
}
const { service, index = 0, showIncluded = false, morph = true } = Astro.props;
const { data } = service;
---

<article class="service-card card group relative flex h-full flex-col p-4 sm:p-6" data-tilt data-reveal data-category={data.category} style={`--i:${index % 6}`}>
  <IconTile icon={`healthicons:${data.icon}`} size="md" class="svc-icon" transitionName={morph ? `icon-${service.id}` : undefined} />
  <h3 class="mt-4 text-base leading-snug font-semibold sm:text-lg">
    <a href={href(`/services/${service.id}`)} class="svc-link after:absolute after:inset-0 after:rounded-[inherit] after:content-['']">{data.title}</a>
  </h3>
  <p class="mt-1.5 hidden text-sm leading-relaxed text-muted sm:block">{data.card}</p>
  {showIncluded && (
    <ul class="mt-3 hidden space-y-1 text-sm sm:block">
      {data.included.slice(0, 3).map((i) => (
        <li class="flex items-start gap-2"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-primary" />{i}</li>
      ))}
    </ul>
  )}
  <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-primary">
    Learn more<span class="sr-only"> about {lcFirst(data.title)}</span>
    <Icon name="arrow-right" size={16} class="svc-arrow" />
  </span>
</article>

<style>
  .service-card {
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(var(--ty, 0px));
    transition: transform 240ms var(--ease-out), box-shadow 240ms var(--ease-out), border-color 240ms, opacity 600ms var(--ease-out), translate 600ms var(--ease-out);
    transition-delay: 0ms, 0ms, 0ms, calc(var(--i, 0) * 60ms), calc(var(--i, 0) * 60ms); /* keep the reveal stagger, not on hover */
  }
  .service-card:hover, .service-card:focus-within {
    --ty: -4px;
    border-color: rgb(14 110 106 / 0.4);
    box-shadow: var(--shadow-lift);
  }
  .service-card:hover :global(.svc-icon), .service-card:focus-within :global(.svc-icon) { transform: translateY(-6px) rotate(-4deg); }
  .service-card :global(.svc-arrow) { transition: transform 240ms var(--ease-out); }
  .service-card:hover :global(.svc-arrow) { transform: translateX(4px); }
  @media (max-width: 639px) { .service-card :global(.svc-icon) { width: 44px !important; height: 44px !important; } }
  .svc-link:focus-visible { outline: none; }
  .svc-link:focus-visible::after { outline: 3px solid var(--color-accent); outline-offset: 2px; }
</style>
