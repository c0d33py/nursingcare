---
interface Props {
  invert?: boolean;
  class?: string;
}
const { invert = false, class: className = '' } = Astro.props;
const gid = `logo-${Math.random().toString(36).slice(2, 8)}`; // unique per instance (header + footer)
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" class="shrink-0">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#18918b"></stop>
        <stop offset="1" stop-color="#0a4f4c"></stop>
      </linearGradient>
    </defs>
    <path d="M5 38V18.5C5 10 11.7 3 20 3s15 7 15 15.5V38z" fill={`url(#${gid})`}></path>
    <circle cx="20" cy="10.5" r="2.2" fill="#e7a93c"></circle>
    <path d="M20 32s-7.6-4.6-7.6-10.2c0-2.6 2-4.6 4.4-4.6 1.4 0 2.6.7 3.2 1.7.6-1 1.8-1.7 3.2-1.7 2.4 0 4.4 2 4.4 4.6C27.6 27.4 20 32 20 32z" fill="#fff"></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['font-display text-[1.45rem] font-semibold tracking-tight', invert ? 'text-white' : 'text-ink']}>Heaven</span>
    <span class:list={['mt-1 text-[0.66rem] font-semibold uppercase tracking-[0.16em]', invert ? 'text-accent' : 'text-primary']}>Nursing Care 24/7</span>
  </span>
</span>
