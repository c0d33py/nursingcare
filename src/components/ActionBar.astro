---
// Mobile action bar (docs/01 §6.3, M07) + desktop floating WhatsApp button (M08).
import { site, href, waLink } from '../site';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const onBook = path.startsWith(href('/book-a-visit'));
const onHome = path === href('/');
---

{!path.startsWith(href('/book-a-visit/thank-you')) && (
  <nav class="action-bar lg:hidden" aria-label="Quick contact" data-action-bar data-wait-hero={onHome || undefined}>
    <a href={site.phone.href} data-umami-event="call_click" data-umami-event-placement="action_bar">
      <Icon name="phone" size={22} />Call
    </a>
    <a href={waLink()} class="is-wa" target="_blank" rel="noopener" data-umami-event="whatsapp_click" data-umami-event-placement="action_bar">
      <Icon name="message-circle" size={22} />WhatsApp
    </a>
    {!onBook && (
      <a href={href('/book-a-visit')} class="is-book">
        <Icon name="calendar-check" size={22} />Book visit
      </a>
    )}
  </nav>
)}

{!onBook && (
  <a href={waLink()} class="wa-float hidden lg:flex" target="_blank" rel="noopener" data-wa-float data-umami-event="whatsapp_click" data-umami-event-placement="floating" aria-label="Chat with us on WhatsApp, available 24/7">
    <Icon name="message-circle" size={28} />
    <span class="wa-tip" aria-hidden="true">Chat with us on WhatsApp — 24/7</span>
  </a>
)}

<style>
  .action-bar {
    view-transition-name: action-bar;
    position: fixed; inset: auto 0 0 0; z-index: 40;
    display: flex; gap: 6px; padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.95); border-top: 1px solid var(--color-line);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    box-shadow: 0 -8px 24px rgb(16 36 58 / 0.08);
    transition: translate 280ms var(--ease-out);
  }
  @media (min-width: 1024px) { .action-bar { display: none; } }
  .action-bar a {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    min-height: 48px; border-radius: 14px; font-size: 0.85rem; font-weight: 700; color: var(--color-ink);
  }
  .action-bar a:active { transform: scale(0.97); }
  .action-bar .is-wa { background: var(--color-wa); color: white; }
  .action-bar .is-book { background: var(--color-primary); color: white; }
  :global(html.js) .action-bar[data-wait-hero]:not(.is-shown) { translate: 0 110%; }

  .wa-float {
    position: fixed; right: 28px; bottom: 28px; z-index: 40;
    width: 60px; height: 60px; border-radius: 999px; align-items: center; justify-content: center;
    background: var(--color-wa); color: white; box-shadow: 0 12px 32px rgb(7 94 84 / 0.4);
    transition: scale 300ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 300ms;
  }
  :global(html.js) .wa-float:not(.is-shown) { scale: 0.8; opacity: 0; pointer-events: none; }
  .wa-float.is-ping::before, .wa-float.is-ping::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; border: 2px solid var(--color-wa);
    animation: wa-ping 1.2s var(--ease-out) 2;
  }
  .wa-float.is-ping::after { animation-delay: 0.3s; }
  @keyframes wa-ping { from { opacity: 0.8; scale: 1; } to { opacity: 0; scale: 1.6; } }
  .wa-tip {
    position: absolute; right: calc(100% + 12px); white-space: nowrap; padding: 0.5rem 0.85rem; border-radius: 12px;
    background: var(--color-ink); color: white; font-size: 0.9rem; font-weight: 600;
    opacity: 0; translate: 6px 0; pointer-events: none; transition: opacity 200ms, translate 200ms var(--ease-out);
  }
  .wa-float:hover .wa-tip, .wa-float:focus-visible .wa-tip { opacity: 1; translate: 0 0; }
</style>
