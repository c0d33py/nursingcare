---
import { getCollection } from 'astro:content';
import { site, href } from '../site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import EmergencyNotice from './EmergencyNotice.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const legal = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);

const columns = [
  {
    title: 'Services',
    links: [...services.map((s) => ({ label: s.data.title, href: href(`/services/${s.id}`) })), { label: 'Care plans', href: href('/care-plans') }],
  },
  {
    title: 'Company',
    links: [
      { label: 'About us', href: href('/about') },
      { label: 'Our care team', href: href('/about/care-team') },
      { label: 'Quality & safety', href: href('/about/quality-and-safety') },
      { label: 'How it works', href: href('/how-it-works') },
      { label: 'Areas we serve', href: href('/areas-we-serve') },
      { label: 'For hospitals & doctors', href: href('/for-hospitals-and-doctors') },
    ],
  },
  {
    title: 'Help',
    links: [
      { label: 'FAQ', href: href('/faq') },
      { label: 'Who we care for', href: href('/who-we-care-for') },
      { label: 'Families abroad', href: href('/who-we-care-for/overseas-families') },
      { label: 'Book a home visit', href: href('/book-a-visit') },
      { label: 'Contact', href: href('/contact') },
    ],
  },
];
---

<footer class="bg-night text-white/80">
  <div class="container-x border-t border-white/10 py-16">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr_1fr_1fr_1.2fr]">
      <div>
        <a href={href('/')} aria-label={`${site.name} — home`} class="inline-block rounded-lg"><Logo invert /></a>
        <p class="mt-5 font-display text-lg text-white">{site.tagline}</p>
        <p class="mt-3 text-[0.98rem] text-white/70">{site.blurb}</p>
        {site.social.length > 0 && (
          <ul class="mt-5 flex gap-3">
            {site.social.map((s) => <li><a href={s.href} class="underline" rel="noopener" target="_blank">{s.label}</a></li>)}
          </ul>
        )}
      </div>

      {columns.map((col) => (
        <details class="foot-col" open>
          <summary class="mb-4 flex items-center justify-between text-sm font-semibold uppercase tracking-[0.12em] text-white">
            {col.title}<Icon name="chevron-down" size={18} class="lg:hidden" />
          </summary>
          <ul class="space-y-2.5 text-[0.98rem]">
            {col.links.map((l) => <li><a href={l.href} class="hover:text-white hover:underline">{l.label}</a></li>)}
          </ul>
        </details>
      ))}

      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.12em] text-white">Contact</p>
        <ul class="space-y-4 text-[0.98rem]">
          <li>
            <a href={site.phone.href} class="flex items-start gap-3 hover:text-white" data-umami-event="call_click" data-umami-event-placement="footer">
              <Icon name="phone" size={20} class="mt-0.5 text-accent" />
              <span><span class="block text-lg font-semibold text-white">{site.phone.display}</span>Call / WhatsApp · 24/7</span>
            </a>
          </li>
          <li>
            <a href={site.directionsUrl} class="flex items-start gap-3 hover:text-white" target="_blank" rel="noopener">
              <Icon name="map-pin" size={20} class="mt-0.5 text-accent" />
              <span>{site.address.full}<span class="block text-sm text-accent underline">Get directions</span></span>
            </a>
          </li>
          {site.email && (
            <li><a href={`mailto:${site.email}`} class="flex items-center gap-3 hover:text-white"><Icon name="mail" size={20} class="text-accent" />{site.email}</a></li>
          )}
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8">
      <EmergencyNotice tone="dark" />
      <div class="mt-6 flex flex-col gap-4 text-sm text-white/60 lg:flex-row lg:items-center lg:justify-between">
        <p>© {new Date().getFullYear()} {site.name}. {site.signOff}</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {legal.map((l) => <li><a href={href(`/legal/${l.id}`)} class="hover:text-white hover:underline">{l.data.title}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot-col summary { list-style: none; cursor: default; }
  .foot-col summary::-webkit-details-marker { display: none; }
  @media (min-width: 1024px) { .foot-col summary { pointer-events: none; } }
  @media (max-width: 1023px) {
    .foot-col { border-bottom: 1px solid rgb(255 255 255 / 0.1); }
    .foot-col summary { min-height: 52px; margin: 0; cursor: pointer; }
    .foot-col ul { padding-bottom: 1rem; }
  }
</style>

<script>
  // Footer columns are open on desktop, collapsed accordions on mobile.
  if (matchMedia('(max-width: 1023px)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('.foot-col').forEach((d) => (d.open = false));
  }
</script>
