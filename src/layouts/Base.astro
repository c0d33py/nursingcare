---
import '../styles/global.css';
import { site, href, asset } from '../site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';

interface Props {
  title: string; // full <title>, ≤ 60 chars (docs/02 §13.1)
  description: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, schema = [], noindex = false, ogImage = '/og/default.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(asset(ogImage), Astro.site).href;
const umami = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

const business = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': new URL(href('/'), Astro.site).href + '#business',
  name: site.name,
  description: site.blurb,
  url: new URL(href('/'), Astro.site).href,
  logo: new URL(asset('/icons/icon-512.png'), Astro.site).href,
  image: og,
  telephone: site.phone.schema,
  ...(site.email && { email: site.email }),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  areaServed: { '@type': 'City', name: 'Lahore' },
  ...(site.social.length && { sameAs: site.social.map((s) => s.href) }),
};
---

<!doctype html>
<html lang="en" data-motion="B">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0e6e6a" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/icons/apple-touch-icon.png')} />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_PK" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Motion tier before first paint (docs/03 §3.2). ?motion=A|B|C forces a tier for QA. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, q = new URLSearchParams(location.search).get('motion');
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var save = navigator.connection && navigator.connection.saveData;
        var desk = matchMedia('(pointer: fine) and (min-width: 1024px)').matches;
        var strong = (navigator.hardwareConcurrency || 4) >= 4 && (navigator.deviceMemory || 4) >= 4;
        d.classList.add('js');
        d.dataset.motion = /^[ABC]$/.test(q || '') ? q : reduce || save ? 'C' : desk && strong ? 'A' : 'B';
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...s })} />)}
    {umami && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umami}></script>}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
    <ActionBar />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
