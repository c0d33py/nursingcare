---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, site } from '../../site';
import { categories, plans, roles } from '../../data/content';
import PageHero from '../../components/PageHero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CareKit from '../../components/CareKit.astro';
import CareFinderSection from '../../components/CareFinderSection.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const faqs = (await getCollection('faqs')).filter((f) => f.data.category === 'Services').map((f) => ({ id: f.id, ...f.data }));
const schema = [{
  '@type': 'CollectionPage',
  name: 'Home healthcare services in Lahore',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem', position: i + 1,
      item: { '@type': 'Service', name: s.data.title, url: new URL(href(`/services/${s.id}`), Astro.site).href },
    })),
  },
}];
---

<Base title="Home Healthcare Services in Lahore | Heaven Nursing Care" description="Doctor visits, nursing, injections & IV, BP and sugar checks, NG tube, catheter and wound care, elderly and post-surgery care, at home in Lahore." schema={schema}>
  <PageHero
    eyebrow="Our services"
    title="Home healthcare services in Lahore"
    subtitle="Medical, nursing and personal care, coordinated by one team and delivered at home, day or night."
    crumbs={[{ label: 'Services' }]}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={href('/book-a-visit')} class="btn btn-primary">Book a home visit</a>
      <a href={href('/#care-finder')} class="btn btn-outline">Find the right care</a>
    </div>
  </PageHero>
  <TrustStrip />

  <section class="section" aria-labelledby="kit-title">
    <div class="container-x">
      <SectionHeader id="kit-title" eyebrow="Everything a clinic would bring" title="Brought to your home" text="Each instrument in our kit stands for a clinical service we provide at home. Explore the kit, or pick from the list." />
      <div class="mt-12"><CareKit /></div>
    </div>
  </section>

  <section class="section bg-sky" aria-labelledby="all-title">
    <div class="container-x">
      <SectionHeader id="all-title" eyebrow="All services" title="Care for every need, under one roof" />
      <div class="mt-8 -mx-4 flex gap-2 overflow-x-auto px-4 pb-2" role="group" aria-label="Filter services" data-filter-group="hub-services">
        <button type="button" class="chip shrink-0 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white" data-filter="all" aria-pressed="true">All services</button>
        {Object.entries(categories).map(([k, v]) => (
          <button type="button" class="chip shrink-0 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white" data-filter={k} aria-pressed="false">{v}</button>
        ))}
      </div>
      <ul id="hub-services" class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
        {services.map((s, i) => <li><ServiceCard service={s} index={i} showIncluded /></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="finder-title">
    <div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <SectionHeader id="finder-title" eyebrow="Care Finder" title="Not sure which service you need?" text="Three quick questions, and we'll point you in the right direction." />
      <CareFinderSection />
    </div>
  </section>

  <section class="section bg-cream" aria-labelledby="plans-title">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeader id="plans-title" eyebrow="How care is arranged" title="A visit, a shift, or round the clock" />
        <a href={href('/care-plans')} class="link shrink-0">Explore care plans →</a>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {plans.map((p, i) => (
          <li class="card p-6" data-reveal style={`--i:${i}`}>
            <p class="text-sm font-semibold uppercase tracking-[0.1em] text-primary">{p.hours}</p>
            <h3 class="h3 mt-2">{p.name}</h3>
            <p class="mt-2 text-muted">{p.bestFor}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="roles-title">
    <div class="container-x">
      <SectionHeader id="roles-title" eyebrow="Who provides your care" title="Five kinds of professionals, one coordinated team" center />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {roles.map((r, i) => (
          <li class="rounded-[var(--radius-card)] border border-line p-5 text-center" data-reveal style={`--i:${i}`}>
            <span class="mx-auto grid size-12 place-items-center rounded-2xl bg-primary-soft text-primary"><Icon name={r.icon} size={24} /></span>
            <p class="mt-3 font-semibold text-ink">{r.name}</p>
            <p class="mt-1 text-[0.95rem] text-muted">{r.summary}</p>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center"><a href={href('/about/care-team')} class="link">Meet our care team →</a></p>
    </div>
  </section>

  <section class="section bg-sky" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeader id="faq-title" eyebrow="FAQ" title="Questions about our services">
        <a href={href('/faq')} class="link mt-6 inline-block">All questions →</a>
      </SectionHeader>
      <FaqList items={faqs} />
    </div>
  </section>

  <CtaBand title="Tell us what's needed — we'll arrange the right professional." text={`Call or WhatsApp ${site.phone.display}, day or night, or book online in two minutes.`} />
</Base>
