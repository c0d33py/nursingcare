---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { href } from '../../site';
import { situations } from '../../data/content';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';

const services = await getCollection('services');
const svc = (slug: string) => services.find((s) => s.id === slug)!;
---

<Base title="Who We Care For | Heaven Nursing Care 24/7" description="Home care for elderly parents, bedridden patients, recovery after surgery, chronic conditions, new mothers and families living abroad.">
  <PageHero
    eyebrow="Who we care for"
    title="Whoever needs care, we'll help you get it right"
    subtitle="Elderly parents, bedridden patients, recovery after surgery, long-term conditions and new mothers. See how we help in each situation."
    crumbs={[{ label: 'Who we care for' }]}
  >
    <nav aria-label="Situations" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {situations.map((s) => (
          <li><a href={s.id === 'families-abroad' ? href('/who-we-care-for/overseas-families') : `#${s.id}`} class="chip hover:border-primary hover:text-primary">{s.title}</a></li>
        ))}
      </ul>
    </nav>
  </PageHero>

  {situations.filter((s) => s.id !== 'families-abroad').map((s, i) => (
    <section id={s.id} class:list={['section scroll-mt-24', i % 2 ? 'bg-sky' : 'bg-white']} aria-labelledby={`${s.id}-title`}>
      <div class:list={['container-x grid items-center gap-12 lg:grid-cols-2', i % 2 && 'lg:[&>*:first-child]:order-2']}>
        <div class="arch-soft relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden bg-primary-soft lg:max-w-none" data-reveal>
          <Image src={s.photo} alt={s.alt} widths={[480, 720, 960]} sizes="(min-width:1024px) 45vw, 92vw" class="h-full w-full object-cover" data-parallax />
        </div>
        <div>
          <p class="eyebrow mb-4">Situation {i + 1}</p>
          <h2 id={`${s.id}-title`} class="h2">{s.title}</h2>
          <p class="mt-4 text-lg text-muted">{s.challenge}</p>
          <h3 class="mt-8 font-semibold text-ink">How we help</h3>
          <ul class="mt-3 space-y-2.5">
            {s.help.map((h) => <li class="flex items-start gap-2.5"><Icon name="check" size={20} class="mt-1 shrink-0 text-primary" />{h}</li>)}
          </ul>
          <h3 class="mt-8 font-semibold text-ink">Relevant services</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {s.services.map((slug) => <li><a href={href(`/services/${slug}`)} class="chip hover:border-primary hover:text-primary">{svc(slug).data.title}<Icon name="arrow-right" size={14} /></a></li>)}
          </ul>
          <a href={href(`/book-a-visit?service=${s.services.join(',')}&situation=${encodeURIComponent(s.title)}`)} class="btn btn-primary mt-8">Arrange care for this situation</a>
        </div>
      </div>
    </section>
  ))}

  <section id="families-abroad" class="section bg-night text-white" aria-labelledby="abroad-title">
    <div class="container-x grid items-center gap-8 lg:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow mb-4 !text-accent">Families living abroad</p>
        <h2 id="abroad-title" class="h2 !text-white">Arranging care from overseas?</h2>
        <p class="mt-3 max-w-2xl text-lg text-white/80">One coordinator, daily WhatsApp updates and a qualified team in Lahore you can trust.</p>
      </div>
      <a href={href('/who-we-care-for/overseas-families')} class="btn btn-light">Care from abroad<Icon name="arrow-right" size={18} class="btn-arrow" /></a>
    </div>
  </section>

  <section class="section-tight bg-cream" aria-labelledby="pro-title">
    <div class="container-x flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 id="pro-title" class="h3">Are you a doctor or hospital?</h2>
        <p class="mt-1 text-muted">Refer patients for safe, skilled care after discharge.</p>
      </div>
      <a href={href('/for-hospitals-and-doctors')} class="btn btn-outline">For hospitals & doctors</a>
    </div>
  </section>

  <CtaBand />
</Base>
