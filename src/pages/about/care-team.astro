---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href } from '../../site';
import { photos } from '../../data/photos';
import { roles } from '../../data/content';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Icon from '../../components/Icon.astro';
import Testimonials from '../../components/Testimonials.astro';
import CtaBand from '../../components/CtaBand.astro';

const services = await getCollection('services');
const title = (slug: string) => services.find((s) => s.id === slug)?.data.title ?? slug;

const matrix = [
  { task: 'Doctor’s examination & prescriptions', who: [1, 0, 0, 0, 0] },
  { task: 'Injections, drips & IV medication', who: [0, 1, 1, 0, 0] },
  { task: 'NG tube & catheter insertion', who: [0, 1, 0, 0, 0] },
  { task: 'Wound dressing', who: [0, 1, 0, 1, 0] },
  { task: 'BP, sugar & vital signs', who: [0, 1, 1, 1, 0] },
  { task: 'Hygiene, feeding & mobility', who: [0, 0, 0, 1, 1] },
  { task: 'Companionship & night support', who: [0, 1, 0, 1, 1] },
];
const selection = [
  { icon: 'id-card', title: 'Identity verified', text: 'CNIC and address checked for every staff member.' },
  { icon: 'graduation-cap', title: 'Qualifications checked', text: 'Nursing and medical certificates verified with the issuing institution.' },
  { icon: 'phone-call', title: 'References taken', text: 'At least two professional references, including a previous employer.' },
  { icon: 'clipboard-check', title: 'Skills assessed', text: 'Clinical staff demonstrate the procedures they will perform.' },
];
---

<Base title="Doctors, Nurses & Caregivers | Heaven Nursing Care" description="Meet the professionals who care for your family: doctors, qualified nurses, paramedical staff, assistant nurses and trained caregivers (ayas).">
  <PageHero
    eyebrow="Our care team"
    title="The right professional for every need"
    subtitle="Doctors, qualified nurses, paramedical staff, assistant nurses and caregivers, each matched to what your loved one needs."
    crumbs={[{ label: 'About', href: href('/about') }, { label: 'Our care team' }]}
    image={photos.careTeam}
    imageAlt="The care team of doctors and nurses smiling together"
  />

  <section class="section" aria-labelledby="roles-title">
    <div class="container-x">
      <SectionHeader id="roles-title" eyebrow="Five roles" title="Who does what" text="Every family's needs are different. We match the role to the task, so you get skilled care without paying for more than you need." />
      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {roles.map((r, i) => (
          <li class="card flex flex-col p-6" data-reveal style={`--i:${i}`}>
            <span class="grid size-14 place-items-center rounded-2xl bg-primary-soft text-primary"><Icon name={r.icon} size={28} /></span>
            <h3 class="h3 mt-5">{r.name}</h3>
            <p class="mt-2 text-muted">{r.summary}</p>
            <details class="role-more mt-4">
              <summary class="inline-flex cursor-pointer items-center gap-1 font-semibold text-primary">What they do <Icon name="chevron-down" size={18} /></summary>
              <ul class="mt-3 space-y-2">
                {r.tasks.map((t) => <li class="flex items-start gap-2"><Icon name="check" size={18} class="mt-1 shrink-0 text-primary" />{t}</li>)}
              </ul>
              <p class="mt-4 text-[0.95rem] text-muted">Services: {r.services.map((s, j) => <>{j > 0 && ', '}<a href={href(`/services/${s}`)} class="link">{title(s)}</a></>)}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-sky" aria-labelledby="matrix-title">
    <div class="container-x">
      <SectionHeader id="matrix-title" eyebrow="Which professional do I need?" title="A quick guide" />
      <div class="mt-10 overflow-x-auto rounded-[var(--radius-card)] border border-line bg-white" data-reveal>
        <table class="w-full min-w-[720px] text-left">
          <caption class="sr-only">Which professional carries out each task</caption>
          <thead class="bg-cream text-sm">
            <tr>
              <th scope="col" class="p-4 font-semibold text-ink">Task</th>
              {roles.map((r) => <th scope="col" class="p-4 text-center font-semibold text-ink">{r.name}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {matrix.map((row) => (
              <tr>
                <th scope="row" class="p-4 font-medium text-ink">{row.task}</th>
                {row.who.map((w) => (
                  <td class="p-4 text-center">
                    {w ? <span class="inline-grid size-7 place-items-center rounded-full bg-primary text-white"><Icon name="check" size={16} label="Yes" /></span> : <span class="text-muted" aria-label="No">—</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="select-title">
    <div class="container-x grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <SectionHeader id="select-title" eyebrow="How we select our staff" title="Trust starts long before the first visit" />
        <ol class="mt-8 grid gap-5 sm:grid-cols-2">
          {selection.map((s, i) => (
            <li class="rounded-2xl border border-line p-5" data-reveal style={`--i:${i}`}>
              <span class="grid size-11 place-items-center rounded-xl bg-accent-soft text-[#8a5a06]"><Icon name={s.icon} size={22} /></span>
              <h3 class="mt-4 font-semibold text-ink">{s.title}</h3>
              <p class="mt-1 text-[0.98rem] text-muted">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="arch-soft relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden bg-primary-soft" data-reveal>
        <Image src={photos.ivDrip} alt="A nurse in a hijab and mask adjusting an IV drip" widths={[480, 720]} sizes="(min-width:1024px) 35vw, 90vw" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="section bg-cream" aria-labelledby="match-title">
    <div class="container-x">
      <SectionHeader id="match-title" eyebrow="Matching" title="Chosen for your family, not just the shift" center />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: 'stethoscope', t: 'Clinical need', d: 'The right qualification for the procedures involved.' },
          { icon: 'users', t: 'Staff gender', d: 'Female or male staff on request.' },
          { icon: 'languages', t: 'Language', d: 'Urdu, Punjabi and English speakers.' },
          { icon: 'repeat', t: 'Continuity', d: 'The same carer wherever possible.' },
        ].map((m, i) => (
          <li class="rounded-[var(--radius-card)] bg-white p-6" data-reveal style={`--i:${i}`}>
            <Icon name={m.icon} size={28} class="text-primary" />
            <h3 class="mt-4 font-semibold text-ink">{m.t}</h3>
            <p class="mt-1 text-muted">{m.d}</p>
          </li>
        ))}
      </ul>
      <p class="mx-auto mt-10 max-w-2xl text-center text-muted">Not comfortable with a staff member? Tell us. We'll listen, and arrange a replacement, usually within 24 hours.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="t-title">
    <div class="container-x">
      <SectionHeader id="t-title" eyebrow="Testimonials" title="What families say about our team" />
      <div class="mt-8"><Testimonials limit={4} /></div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .role-more summary { list-style: none; }
  .role-more summary::-webkit-details-marker { display: none; }
  .role-more summary :global(svg) { transition: transform 240ms var(--ease-in-out); }
  .role-more[open] summary :global(svg) { transform: rotate(180deg); }
</style>
