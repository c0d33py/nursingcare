---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href } from '../../site';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const all = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
  return all.map((page) => ({ params: { slug: page.id }, props: { page, all } }));
}
const { page, all } = Astro.props;
const { Content, headings } = await render(page);
const updated = page.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${page.data.title} | Heaven Nursing Care`} description={page.data.description}>
  <section class="bg-sky">
    <div class="container-x py-12 lg:py-16">
      <Breadcrumbs items={[{ label: page.data.title }]} />
      <h1 class="h1 mt-6">{page.data.title}</h1>
      <p class="mt-3 text-muted">Last updated {updated}</p>
    </div>
  </section>
  <section class="section pt-12">
    <div class="container-x grid gap-12 lg:grid-cols-[240px_1fr]">
      <aside class="lg:sticky lg:top-[calc(var(--header-h)+24px)] lg:self-start">
        {headings.length > 0 && (
          <nav aria-label="On this page" class="mb-8">
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.12em] text-muted">On this page</p>
            <ul class="space-y-2 text-[0.98rem]">
              {headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`} class="text-ink hover:text-primary hover:underline">{h.text}</a></li>)}
            </ul>
          </nav>
        )}
        <nav aria-label="Legal pages" class="hidden lg:block">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.12em] text-muted">Policies</p>
          <ul class="space-y-2 text-[0.98rem]">
            {all.map((p) => <li><a href={href(`/legal/${p.id}`)} class:list={['hover:text-primary', p.id === page.id ? 'font-semibold text-primary' : 'text-ink']} aria-current={p.id === page.id ? 'page' : undefined}>{p.data.title}</a></li>)}
          </ul>
        </nav>
      </aside>
      <article class="prose-care"><Content /></article>
    </div>
  </section>
</Base>
